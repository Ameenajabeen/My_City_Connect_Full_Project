NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Common PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mycityconnect?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# AI / duplicate detection
MONGODB_URI=mongodb://localhost:27017/mycityconnect
AI_SERVICE_URL=http://localhost:8000
AI_AUTO_SELECT_THRESHOLD=0.70
AI_DEV_SIMULATION=false
YOLO_MODEL_PATH=
OPENAI_API_KEY=

# Evidence storage: local or s3
STORAGE_DRIVER=local
UPLOAD_DIR=public/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mycityconnect-evidence

# Push notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

GOOGLE_MAPS_API_KEY=
